# ==============================================================================
# Strands Sentinel Environment Configuration
# ==============================================================================

# Pillar 1: Language Models
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Strands Decider 2B Governance Model
DECIDER_BASE_URL=http://localhost:8001
DECIDER_MODE=mock
DECIDER_CONFIDENCE_THRESHOLD=0.65
FAIL_CLOSED_IF_DECIDER_UNAVAILABLE=true

# Pillar 2: Harness & Services
CRM_BASE_URL=http://localhost:8000
LEDGER_BASE_URL=http://localhost:8081
CRM_PORT=8000
LEDGER_PORT=8081
SESSION_TIMEOUT_MINUTES=15
LOG_LEVEL=INFO

# Pillar 3: Sandbox (NVIDIA OpenShell)
OPENSHELL_POLICY_PATH=sandbox/openshell.toml

# Pillar 4: Knowledge Foundation (Qdrant Vector DB)
QDRANT_MODE=memory
# QDRANT_URL=http://localhost:6333

# Pillar 5: Accelerated Tools (NVIDIA NIM)
# Get a free key with 1,000 credits at https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_NIM_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct
